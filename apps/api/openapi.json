  "info": {
    "title": "Mating Marketplace API",
    "description": "REST API for the animal breeding marketplace",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {}
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Database reachability"
          }
        },
        "required": [
          "database"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "example": "ok",
            "description": "'ok' when all dependencies are reachable"
          },
          "service": {
            "type": "string",
            "example": "api"
          },
          "version": {
            "type": "string",
            "example": "0.0.1",
            "description": "Deployed API version"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-06-21T08:00:00.000Z"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 12.34,
            "description": "Process uptime in seconds"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "timestamp",
          "uptimeSeconds",
          "checks"
        ]
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+923001234567"
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+923001234567"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "role": {
            "type": "string",
            "enum": [
              "buyer",
              "breeder",
              "animal_owner"
            ]
          },
          "deviceDescriptor": {
